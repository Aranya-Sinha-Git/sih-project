# Supabase server (FastAPI only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# App
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
MODEL_PATH=
# The frontend calls FastAPI directly; do not use /api unless a tested proxy is configured.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Registration protection. Put a durable rate limiter at the deployment edge
# for multi-instance deployments; these API limits provide a local fallback.
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=3600

# Optional grounded explanations
SIF_LLM_URL=
SIF_LLM_MODEL=local-model
SIF_LLM_TIMEOUT_SECONDS=5
SIF_LLM_MAX_CONTEXT_CHARS=6000

# Frontend-only public configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
