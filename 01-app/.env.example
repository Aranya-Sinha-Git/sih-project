DATABASE_URL=sqlite:///./data/sif_sentinel.db
# Server-side target for the frontend's same-origin /api proxy.
BACKEND_URL=http://127.0.0.1:8000
# Optional direct browser API URL. Prefer /api unless the backend has production CORS configured.
NEXT_PUBLIC_API_URL=/api
# Production API authentication. Use opaque server-side token=name pairs;
# never put these in NEXT_PUBLIC_* variables or the frontend build.
SIF_AUTH_TOKENS=replace-with-random-token=Reviewer Name
# Loopback launcher only; leave unset in deployed environments.
SIF_LOCAL_DEMO=0
